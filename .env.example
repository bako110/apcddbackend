# --- Base de données ---
MONGODB_URI=mongodb://localhost:27017/apcdd-pro

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Liste d'origines autorisées séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Cloudinary (upload images/vidéos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT (authentification admin) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Le compte admin est stocké dans la collection MongoDB "admins"
# (modèle Admin.model.js), pas dans des variables d'environnement.
